{
  "openapi": "3.1.0",
  "info": {
    "title": "Hudson local agent API",
    "version": "0.1.0",
    "description": "Preview API for a loopback-only, single-identity host. Paths are currently unversioned and compatibility is not promised. Agent configuration is loaded at startup; this API does not publish agents or manage credentials. All timestamps are Unix milliseconds. Model and tool execution is asynchronous relative to submissions. No hosted authentication or event streaming is implemented."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4318"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Inspect local server mode and persistence",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "default": {
            "description": "Runtime errors return JSON error; malformed HTTP/JSON/UUID and body-limit rejections may return text. Statuses include 400, 403, 404, 409, 413, 415, 422, 500.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "openapi",
        "summary": "Read this API contract",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Runtime errors return JSON error; malformed HTTP/JSON/UUID and body-limit rejections may return text. Statuses include 400, 403, 404, 409, 413, 415, 422, 500.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/runs": {
      "post": {
        "operationId": "createRun",
        "summary": "Submit a task to the configured root agent",
        "responses": {
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunHandle"
                }
              }
            }
          },
          "default": {
            "description": "Runtime errors return JSON error; malformed HTTP/JSON/UUID and body-limit rejections may return text. Statuses include 400, 403, 404, 409, 413, 415, 422, 500.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Submission"
              }
            }
          }
        },
        "description": "Returns after scheduling, not completion. An optional request_key deduplicates submissions; changed input or budget binding conflicts. The HTTP body limit is 64 KiB."
      }
    },
    "/runs/{id}": {
      "get": {
        "operationId": "getRun",
        "summary": "Read status, wait, result and reported usage",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "default": {
            "description": "Runtime errors return JSON error; malformed HTTP/JSON/UUID and body-limit rejections may return text. Statuses include 400, 403, 404, 409, 413, 415, 422, 500.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/runs/{id}/children": {
      "get": {
        "operationId": "listChildren",
        "summary": "Read direct child runs",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Run"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Runtime errors return JSON error; malformed HTTP/JSON/UUID and body-limit rejections may return text. Statuses include 400, 403, 404, 409, 413, 415, 422, 500.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/runs/{id}/events": {
      "get": {
        "operationId": "listEvents",
        "summary": "Read events after an exclusive sequence cursor",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Event"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Runtime errors return JSON error; malformed HTTP/JSON/UUID and body-limit rejections may return text. Statuses include 400, 403, 404, 409, 413, 415, 422, 500.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ]
      }
    },
    "/runs/{id}/resume": {
      "post": {
        "operationId": "resumeRun",
        "summary": "Schedule continuation using the run\u2019s configured executor",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunHandle"
                }
              }
            }
          },
          "default": {
            "description": "Runtime errors return JSON error; malformed HTTP/JSON/UUID and body-limit rejections may return text. Statuses include 400, 403, 404, 409, 413, 415, 422, 500.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/runs/{id}/input": {
      "post": {
        "operationId": "replyToRun",
        "summary": "Answer the specific saved question and schedule continuation",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunHandle"
                }
              }
            }
          },
          "default": {
            "description": "Runtime errors return JSON error; malformed HTTP/JSON/UUID and body-limit rejections may return text. Statuses include 400, 403, 404, 409, 413, 415, 422, 500.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserReply"
              }
            }
          }
        },
        "description": "Copy question_id from wait.question_id. Repeating the same question, request_key and input is idempotent. Changed key contents or a stale question conflicts. Replies are recorded in event history."
      }
    },
    "/runs/{id}/cancel": {
      "post": {
        "operationId": "cancelRun",
        "summary": "Request cancellation, including known child runs",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunHandle"
                }
              }
            }
          },
          "default": {
            "description": "Runtime errors return JSON error; malformed HTTP/JSON/UUID and body-limit rejections may return text. Statuses include 400, 403, 404, 409, 413, 415, 422, 500.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "description": "Stops new work. Active or uncertain external effects may remain unresolved; inspect run status. Does not undo completed effects."
      }
    },
    "/operations/{id}": {
      "get": {
        "operationId": "getOperation",
        "summary": "Read an operation and its exact approval preview",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            }
          },
          "default": {
            "description": "Runtime errors return JSON error; malformed HTTP/JSON/UUID and body-limit rejections may return text. Statuses include 400, 403, 404, 409, 413, 415, 422, 500.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/operations/{id}/approval": {
      "post": {
        "operationId": "decideApproval",
        "summary": "Approve or deny the exact operation and schedule its run",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunHandle"
                }
              }
            }
          },
          "default": {
            "description": "Runtime errors return JSON error; malformed HTTP/JSON/UUID and body-limit rejections may return text. Statuses include 400, 403, 404, 409, 413, 415, 422, 500.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Decision"
              }
            }
          }
        },
        "description": "Decision applies to the persisted request digest under current policy. Local approval expires after 60 seconds. Inspect the operation arguments before deciding."
      }
    }
  },
  "components": {
    "schemas": {
      "VersionRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "version"
        ],
        "additionalProperties": false
      },
      "RunHandle": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "run_id"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "mode": {
            "enum": [
              "fixture",
              "configured"
            ]
          },
          "durable": {
            "type": "boolean"
          }
        },
        "required": [
          "mode",
          "durable"
        ],
        "additionalProperties": false
      },
      "Submission": {
        "type": "object",
        "properties": {
          "input": {},
          "request_key": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "input"
        ],
        "additionalProperties": false
      },
      "UserReply": {
        "type": "object",
        "properties": {
          "input": {},
          "request_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "question_id": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "input",
          "request_key",
          "question_id"
        ],
        "additionalProperties": false
      },
      "Decision": {
        "type": "object",
        "properties": {
          "approved": {
            "type": "boolean"
          }
        },
        "required": [
          "approved"
        ],
        "additionalProperties": false
      },
      "Goal": {
        "type": "object",
        "properties": {
          "objective": {
            "type": "string"
          },
          "success_schema": {},
          "criteria": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Criterion"
            },
            "default": []
          }
        },
        "required": [
          "objective",
          "success_schema"
        ],
        "additionalProperties": false
      },
      "Assessment": {
        "type": "object",
        "properties": {
          "passed": {
            "type": "boolean"
          },
          "feedback": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "description": "Successful recorded tool executions; provenance alone does not establish factual correctness."
          }
        },
        "required": [
          "passed",
          "feedback"
        ],
        "additionalProperties": false
      },
      "Usage": {
        "type": "object",
        "properties": {
          "model_calls": {
            "type": "integer",
            "minimum": 0
          },
          "tool_calls": {
            "type": "integer",
            "minimum": 0
          },
          "operations": {
            "type": "integer",
            "minimum": 0
          },
          "reported_model_calls": {
            "type": "integer",
            "minimum": 0
          },
          "reported_input_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "reported_output_tokens": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "model_calls",
          "tool_calls",
          "operations",
          "reported_model_calls",
          "reported_input_tokens",
          "reported_output_tokens"
        ],
        "additionalProperties": false
      },
      "WaitReason": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "approval"
              },
              "operation_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "type",
              "operation_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "reconciliation"
              },
              "operation_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "type",
              "operation_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "user_input"
              },
              "prompt": {
                "type": "string"
              },
              "question_id": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "type",
              "prompt",
              "question_id"
            ],
            "additionalProperties": false
          }
        ]
      },
      "Run": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "agent_ref": {
            "$ref": "#/components/schemas/VersionRef"
          },
          "parent_operation": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "goal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Goal"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "waiting",
              "cancelling",
              "completed",
              "failed",
              "cancelled"
            ]
          },
          "wait": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WaitReason"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "result": {},
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "assessment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Assessment"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "agent_ref",
          "parent_operation",
          "goal",
          "status",
          "wait",
          "reason",
          "result",
          "usage",
          "assessment"
        ],
        "additionalProperties": false
      },
      "ApprovalDecision": {
        "type": "object",
        "properties": {
          "actor_id": {
            "type": "string"
          },
          "request_digest": {
            "type": "string"
          },
          "approved": {
            "type": "boolean"
          },
          "decided_at": {
            "type": "integer",
            "minimum": 0
          },
          "expires_at": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "actor_id",
          "request_digest",
          "approved",
          "decided_at",
          "expires_at"
        ],
        "additionalProperties": false
      },
      "Approval": {
        "type": "object",
        "properties": {
          "request_digest": {
            "type": "string"
          },
          "decisions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprovalDecision"
            }
          }
        },
        "required": [
          "request_digest",
          "decisions"
        ],
        "additionalProperties": false
      },
      "TokenUsage": {
        "type": "object",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "input_tokens",
          "output_tokens"
        ],
        "additionalProperties": false
      },
      "Operation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "enum": [
              "model",
              "tool",
              "verify"
            ]
          },
          "status": {
            "enum": [
              "pending",
              "waiting_approval",
              "running",
              "unknown",
              "succeeded",
              "failed",
              "denied",
              "cancelled"
            ]
          },
          "tool_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "arguments": {},
          "request_digest": {
            "type": "string"
          },
          "approval": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Approval"
              },
              {
                "type": "null"
              }
            ]
          },
          "token_usage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TokenUsage"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "run_id",
          "kind",
          "status",
          "tool_name",
          "arguments",
          "request_digest",
          "approval",
          "token_usage"
        ],
        "additionalProperties": false
      },
      "Metadata": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "workspace_id": {
            "type": "string"
          },
          "schema_version": {
            "type": "integer",
            "minimum": 0
          },
          "created_at": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "workspace_id",
          "schema_version",
          "created_at"
        ],
        "additionalProperties": false
      },
      "Event": {
        "type": "object",
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/Metadata"
          },
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "operation_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "event_type": {
            "enum": [
              "run_created",
              "input_received",
              "operation_requested",
              "approval_requested",
              "approval_decided",
              "operation_started",
              "operation_settled",
              "operation_unknown",
              "run_waiting",
              "run_resumed",
              "cancellation_requested",
              "run_finished",
              "assessment_recorded"
