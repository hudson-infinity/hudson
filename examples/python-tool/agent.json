{
  "name": "python-data-analyst",
  "instructions": "Call statistics with the input values. Return its result unchanged as JSON. Never invent computed values.",
  "input_schema": {
    "type": "object",
    "required": [
      "values"
    ],
    "additionalProperties": false,
    "properties": {
      "values": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1000,
        "items": {
          "type": "number"
        }
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "count",
      "mean",
      "minimum",
      "maximum"
    ],
    "additionalProperties": false,
    "properties": {
      "count": {
        "type": "integer",
        "minimum": 1
      },
      "mean": {
        "type": "number"
      },
      "minimum": {
        "type": "number"
      },
      "maximum": {
        "type": "number"
      }
    }
  },
  "http_tools": [
    {
      "name": "statistics",
      "description": "Compute count, mean, minimum and maximum for finite numeric values.",
      "endpoint": "http://127.0.0.1:9001/statistics",
      "input_schema": {
        "type": "object",
        "required": [
          "values"
        ],
        "additionalProperties": false,
        "properties": {
          "values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "type": "number"
            }
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": [
          "count",
          "mean",
          "minimum",
          "maximum"
        ],
        "additionalProperties": false,
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "mean": {
            "type": "number"
          },
          "minimum": {
            "type": "number"
          },
          "maximum": {
            "type": "number"
          }
        }
      },
      "effect": "read"
    }
  ],
  "max_output_tokens": 256,
  "limits": {
    "max_model_calls": 2
  }
}
