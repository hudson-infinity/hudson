{
  "name": "data-analyst",
  "instructions": "Given the input object's values array, return only JSON containing count and mean. Use exactly the supplied values.",
  "input_schema": {
    "type": "object",
    "required": ["values"],
    "additionalProperties": false,
    "properties": {
      "values": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"type": "number"}}
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["count", "mean"],
    "additionalProperties": false,
    "properties": {"count": {"type": "integer", "minimum": 1}, "mean": {"type": "number"}}
  },
  "max_output_tokens": 256,
  "limits": {"max_model_calls": 2}
}
